# Copy to .env.local (never commit .env.local). Names only — no real secrets here.

# PayPal sandbox (server-side; from the owner's PayPal sandbox Business app)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Same value as PAYPAL_CLIENT_ID; this one is exposed to the browser for the PayPal JS SDK.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Sandbox marker for this deployment. Keep as: sandbox
# (The REST client defaults to the sandbox API base below; there is no live/real-money mode.)
PAYPAL_ENV=
# Optional. Defaults to https://api-m.sandbox.paypal.com when unset.
PAYPAL_API_BASE=

# AI verification (optional — the demo runs key-free without these)
# AI_BASE_URL is an OpenAI-compatible provider base URL (e.g. https://provider.example/v1);
# the AI client POSTs to {AI_BASE_URL}/chat/completions (no double-append if already suffixed).
# If any of the three is unset, the deterministic fallback verifier runs instead.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Optional. SQLite file path. Defaults to ./data/rilis.db (":memory:" for tests).
RILIS_DB_PATH=
